<?xml version="1.0" encoding="utf-8"?>
<androidx.cardview.widget.CardView xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_margin="10dp"
    android:alpha="0.5"
    app:cardCornerRadius="15dp">

    <FrameLayout
        android:background="@android:color/transparent"
        android:layout_width="match_parent"
        android:layout_height="match_parent">
        <ImageView
            android:layout_width="match_parent"
            android:background="#dddddd"
            android:layout_height="match_parent"/>
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical">
            <RelativeLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="horizontal">
                <TextView
                    android:id="@+id/word_listening_word"
                    android:layout_centerVertical="true"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_margin="10dp"
                    android:text="單字"
                    android:textSize="20dp"
                    android:textColor="#008800"
                    android:layout_alignParentLeft="true"/>
                <TextView
                    android:id="@+id/word_listening_kk"
                    android:layout_centerVertical="true"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_margin="10dp"
                    android:text="kk"
                    android:textSize="20dp"
                    android:layout_toRightOf="@id/word_listening_word"
                    android:textColor="#888888"/>
                <com.google.android.material.imageview.ShapeableImageView
                    android:id="@+id/word_listening_speak"
                    android:layout_width="50dp"
                    android:layout_height="50dp"
                    android:layout_margin="5dp"
                    android:layout_alignParentRight="true"
                    android:layout_centerVertical="true"
                    android:scaleType="fitCenter"
                    app:contentPadding="7dp"
                    android:src="@drawable/badge"

                    android:clickable="true"
                    android:foreground="@drawable/circle_ripple"
                    app:shapeAppearanceOverlay="@style/circle" />

            </RelativeLayout>
            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="vertical">
                <TextView
                    android:id="@+id/word_listening_word_zh"
                    android:layout_centerVertical="true"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_margin="10dp"
                    android:text="單字中文"
                    android:textSize="20dp"
                    android:textColor="#333333"/>
                <TextView
                    android:id="@+id/word_listening_sentence"
                    android:layout_centerVertical="true"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_margin="10dp"
                    android:text="例句"
                    android:textSize="20dp"
                    android:textColor="#333333"/>
                <TextView
                    android:id="@+id/word_listening_sentence_zh"
                    android:layout_centerVertical="true"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_margin="10dp"
                    android:text="翻譯"
                    android:textSize="20dp"
                    android:textColor="#333333"/>
                <TextView
                    android:id="@+id/word_listening_remart"
                    android:layout_centerVertical="true"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_margin="10dp"
                    android:text="備註"
                    android:textSize="20dp"
                    android:textColor="#333333"/>
            </LinearLayout>
        </LinearLayout>
    </FrameLayout>

</androidx.cardview.widget.CardView>
