<?xml version="1.0" encoding="utf-8"?>
<FrameLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:id="@+id/main"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    tools:context=".word_listening.WordListening">

    <!--背景-->
    <ImageView
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:src="@drawable/m13_bg"
        android:alpha="0.2"
        android:scaleType="fitCenter"/>

    <ScrollView
        android:layout_width="match_parent"
        android:layout_height="match_parent">
        <LinearLayout
            android:id="@+id/word_listening_word_layout"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical">

        </LinearLayout>
    </ScrollView>

    <RelativeLayout
        android:layout_width="match_parent"
        android:layout_height="match_parent">
        <LinearLayout
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:orientation="horizontal"
            android:layout_centerHorizontal="true"
            android:layout_alignParentBottom="true">
            <com.google.android.material.imageview.ShapeableImageView
                android:id="@+id/word_listening_pre_page"
                android:layout_width="70dp"
                android:layout_height="70dp"
                android:layout_marginLeft="17dp"
                android:scaleType="fitCenter"
                android:src="@drawable/lan"

                android:clickable="true"
                android:foreground="@drawable/rect_ripple"/>
            <com.google.android.material.imageview.ShapeableImageView
                android:id="@+id/word_listening_next_page"
                android:layout_width="70dp"
                android:layout_height="70dp"
                android:scaleX="1.3"
                android:scaleY="1.3"
                android:scaleType="fitCenter"
                android:src="@drawable/suzoki"

                android:clickable="true"
                android:foreground="@drawable/rect_ripple" />
        </LinearLayout>
    </RelativeLayout>



</FrameLayout>