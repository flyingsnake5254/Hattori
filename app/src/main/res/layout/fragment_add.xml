<?xml version="1.0" encoding="utf-8"?>
<FrameLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:tools="http://schemas.android.com/tools"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    tools:context=".bottom_nav_bar.AddFragment">

    <!--背景-->
    <ImageView
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:src="@drawable/m15_bg"
        android:alpha="0.2"
        android:scaleType="fitCenter"/>


    <ScrollView
        android:layout_width="match_parent"
        android:layout_height="match_parent">
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="match_parent"
            android:orientation="vertical">
            <!-- image -->
            <ImageView
                android:layout_width="match_parent"
                android:layout_height="400dp"
                android:visibility="gone"
                android:id="@+id/photo"/>

            <!-- word card -->
            <LinearLayout
                android:id="@+id/word_cardview"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_margin="20dp"
                android:orientation="horizontal">
            </LinearLayout>

            <!-- 中英文 radio button -->
            <RadioGroup
                android:id="@+id/language_radio_group"
                android:orientation="horizontal"
                android:layout_width="match_parent"
                android:visibility="gone"
                android:layout_height="wrap_content">
                <RadioButton
                    android:id="@+id/radio_english"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"

                    android:layout_marginRight="10dp"
                    android:text="英文"/>
                <RadioButton
                    android:id="@+id/radio_chinese"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="中文"/>

            </RadioGroup>

            <!-- block, line, element radio group -->
            <RadioGroup
                android:id="@+id/text_mode_radio_group"
                android:visibility="gone"
                android:orientation="horizontal"
                android:layout_width="match_parent"
                android:layout_height="wrap_content">
                <RadioButton
                    android:id="@+id/block"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="block"/>
                <RadioButton
                    android:id="@+id/line"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="line"/>
                <RadioButton
                    android:id="@+id/element"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="element"/>

            </RadioGroup>


            <!-- 擷取文字 -->
            <LinearLayout
                android:id="@+id/recogn_english_layout"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:visibility="gone"
                android:orientation="vertical"/>

            <LinearLayout
                android:id="@+id/recogn_chinese_layout"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:visibility="gone"
                android:orientation="vertical"/>



        </LinearLayout>
    </ScrollView>

<!-- button -->
    <RelativeLayout
        android:layout_width="match_parent"
        android:layout_height="match_parent">

        <!--add button-->
        <com.google.android.material.imageview.ShapeableImageView
            android:id="@+id/btn_add"
            android:layout_width="70dp"
            android:layout_height="70dp"
            android:layout_alignParentRight="true"
            android:layout_above="@id/btn_save"
            android:layout_marginRight="20dp"
            android:layout_marginBottom="10dp"
            android:scaleType="fitCenter"
            app:contentPadding="7dp"
            android:src="@drawable/kudo_head"
            android:clickable="true"
            android:background="#eeeeee"
            android:foreground="@drawable/circle_ripple"
            app:shapeAppearanceOverlay="@style/circle" />

        <!-- save button -->
        <com.google.android.material.imageview.ShapeableImageView
            android:id="@+id/btn_save"
            android:layout_width="70dp"
            android:layout_height="70dp"
            android:layout_alignParentBottom="true"
            android:layout_alignParentRight="true"
            android:layout_marginRight="20dp"
            android:layout_marginBottom="20dp"
            android:scaleType="fitCenter"
            app:contentPadding="7dp"
            android:src="@drawable/heiji_head"
            android:clickable="true"
            android:background="#eeeeee"
            android:foreground="@drawable/circle_ripple"
            app:shapeAppearanceOverlay="@style/circle" />


    </RelativeLayout>

</FrameLayout>